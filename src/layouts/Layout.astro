---
import '../styles/globals.css';
import { Navigation } from '../components/Navigation';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = 'Lam Ho (Hồ Phạm Lâm @hophamlam), one of a kind, part-time world savior. This is my own private domicile and I will not be harassed.',
  image = '/logo/hophamlam-logo.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Google Fonts - Nunito -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet" />
    
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Lam Ho (Hồ Phạm Lâm @hophamlam)" />
    <meta name="robots" content="index, follow" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ho Pham Lam" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ho Pham Lam",
      "alternateName": [
        "Hồ Phạm Lâm",
        "Ho Pham Lam",
        "@hophamlam",
        "hophamlam",
        "Lam Ho"
      ],
      "url": "https://hophamlam.com",
      "image": new URL(image, Astro.site).toString(),
      "sameAs": [
        "https://github.com/hophamlam",
        "https://t.me/hophamlam"
      ],
      "jobTitle": "Full Stack Developer",
      "description": "Lam Ho (Hồ Phạm Lâm @hophamlam) one of a kind, part-time world savior. This is my own private domicile and I will not be harassed."
    })} />
  </head>
<body class="min-h-screen bg-background antialiased relative flex flex-col">
    <Navigation client:load siteTitle="@hophamlam" />
    <slot />
  </body>
</html>

